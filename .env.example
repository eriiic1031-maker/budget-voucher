# .env 로 복사해서 사용. .env 는 절대 공유/커밋하지 마세요.

COMPANY_BIZNO=1018199999
SAP_COMPANY_CODE=1000

# mock: SAP 없이 테스트 / rfc: 실제 BAPI 호출
SAP_MODE=mock
SAP_USER=VOUCHER_BOT
SAP_DOC_TYPE_INVOICE=KR
SAP_DOC_TYPE_CREDIT=KG
SAP_TAX_DEDUCTIBLE=V1
SAP_TAX_NONDEDUCTIBLE=V3
SAP_TAX_EXEMPT=V0
SAP_VAT_INPUT_GL=11350000

# SAP_MODE=rfc 일 때
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=100
SAP_RFC_USER=
SAP_RFC_PASSWORD=
SAP_LANG=KO

# true 면 auto_post 규칙에 맞고 검증을 통과한 건은 사람 승인 없이 바로 전기
AUTO_POST=false

# 홈택스 매입 세금계산서 수집: mock(데모) | popbill
HOMETAX_PROVIDER=mock
# 팝빌 연동회원 가입 후 발급받은 값 (developers.popbill.com)
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
# true: 팝빌 테스트 서버(개발용), false: 운영 서버
POPBILL_IS_TEST=true
# 팝빌 회원 아이디 (선택)
POPBILL_USER_ID=

# 세금계산서 수신 메일함 (IMAP over SSL)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# 로컬 AI (Ollama) — 회사 데이터가 내 PC 밖으로 나가지 않음. 없거나 실패하면 규칙 방식으로 자동 대체
# [보안 정책] 로컬 AI가 아니면 연동하지 않음: OLLAMA_URL 은 localhost·사내망 주소만 허용 (외부 주소는 차단)
# auto: Ollama가 켜져 있으면 사용 / off: 항상 규칙 방식
AI_MODE=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=180
